# Shown on the sign-in screen and in the apps.
O3_INSTANCE_NAME=Acme O3 Code

# First admin, created on the first start when the instance has no accounts.
# They must choose a new password when they sign in.
O3_ADMIN_EMAIL=admin@example.com
O3_ADMIN_PASSWORD=change-me-on-first-sign-in

# Joins the instance itself to your tailnet as https://o3.<tailnet>.ts.net.
# Create a one-off, pre-approved key tagged tag:o3-instance.
O3_INSTANCE_TS_AUTHKEY=tskey-auth-...
O3_INSTANCE_TS_HOSTNAME=o3
O3_INSTANCE_TS_TAGS=tag:o3-instance

# A Tailscale OAuth client with the auth_keys and devices:core scopes, allowed to
# assign tag:o3-workspace. The instance mints a single-use key for each workspace.
O3_TS_OAUTH_CLIENT_ID=
O3_TS_OAUTH_CLIENT_SECRET=
O3_TS_TAG=tag:o3-workspace

# The workspace image the instance starts for each user.
O3_WORKSPACE_IMAGE=o3code/workspace:latest
